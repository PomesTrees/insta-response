# Copia este archivo a ".env" y rellena los valores reales.
# ".env" nunca debe subirse a git (ya está en .gitignore).

# Inventado por ti; el mismo valor va en el dashboard de Meta al configurar el webhook.
IG_VERIFY_TOKEN=

# Tokens de las cuentas de Instagram conectadas, SEPARADOS POR COMAS. Uno por
# cuenta, generado en API setup with Instagram Login (Meta for Developers).
# Ej: IG_ACCESS_TOKENS=IGAAxxx...,IGAAyyy...
# No hace falta configurar los IDs: se resuelven solos al arrancar con GET /me.
IG_ACCESS_TOKENS=

# Compatibilidad: si solo tienes una cuenta, puedes usar esta en vez de la de
# arriba. Se ignora cuando IG_ACCESS_TOKENS está definida.
IG_ACCESS_TOKEN=

# App settings -> Basic -> App Secret (para verificar la firma de los webhooks).
IG_APP_SECRET=

# Opcional: el "Instagram App Secret" de "API setup with Instagram Login", que es
# distinto al de arriba. Si lo pones, se acepta una firma válida con cualquiera de
# los dos, así no importa cuál use Meta. El log dice cuál validó.
IG_APP_SECRET_ALT=

# IGSID del usuario al que le quieres responder distinto. Opcional.
USUARIO_ESPECIFICO_IGSID=

# Token del bot de Telegram (BotFather).
TELEGRAM_BOT_TOKEN=

# chat_id que te da https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Nota: el dominio del bot NO se configura aquí. Vive en infra/Caddyfile, junto
# al resto de sitios del servidor. Ver DESPLIEGUE-ORACLE.md
